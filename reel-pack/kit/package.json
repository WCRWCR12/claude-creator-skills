{
  "name": "reel-pack-kit",
  "version": "2.0.0",
  "private": true,
  "description": "Starter kit for coded 9:16 reels: Remotion + three.js (react-three-fiber), deterministic frame-by-frame rendering.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "still": "remotion still src/index.ts",
    "sfx": "python ../tools/make_sfx.py public/sfx",
    "pad": "python ../tools/make_pad.py public/myth/pad.wav"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@react-three/fiber": "9.4.0",
    "@remotion/cli": "4.0.533",
    "@remotion/three": "4.0.533",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.533",
    "three": "0.181.2"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/three": "0.181.0",
    "typescript": "5.9.3"
  }
}
